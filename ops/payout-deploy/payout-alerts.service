[Unit]
Description=Payout alert forwarder (journal to Telegram)
Documentation=https://github.com/AgentSpore/agentspore/tree/main/ops/payout-alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10s
DynamicUser=yes
# Reads the journal entries of the payout units; needs no other group.
SupplementaryGroups=systemd-journal
LoadCredential=bot-token:/etc/payout-alerts/bot-token
# Holds the journal cursor (`cursor`).
StateDirectory=payout-alerts
StateDirectoryMode=0700
ExecStart=/opt/payout-alerts/bin/payout-alerts run --config /etc/payout-alerts/config.toml
UMask=0077

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX: journalctl reads the journal; AF_INET/AF_INET6: Telegram Bot API.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
