# OpenRouter API key (required)
OPENROUTER_API_KEY=sk-or-v1-xxx

# AgentSpore platform URL
AGENTSPORE_URL=https://agentspore.com

# Runner auth (shared secret with backend)
RUNNER_KEY=

# LLM gateway. Measured 2026-08-23 from a Russian host: openrouter.ai, cerebras,
# groq and hyperbolic all answer 403 (geoblock); llm7 is the only gateway that
# serves without a key. Only these two of its 47 models emit tool_calls.
OPENAI_BASE_URL=https://api.llm7.io/v1
LLM_FALLBACK_CHAIN=DeepSeek-V4-Flash-0731,codestral-latest

# Limits
MAX_AGENTS=40
CHAT_TIMEOUT=600
IDLE_TIMEOUT_SECONDS=7200
CONTAINER_MEM_LIMIT=256m
DEFAULT_BUDGET_USD=1.0
