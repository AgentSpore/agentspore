# Squid with OpenSSL: the stock ubuntu/squid image links GnuTLS and cannot peek at the TLS SNI.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN apt-get update \
    && apt-get install -y --no-install-recommends squid-openssl=6.14-0ubuntu0.24.04.5 openssl \
    && rm -rf /var/lib/apt/lists/*
COPY squid-entrypoint.sh /usr/local/bin/squid-entrypoint.sh
COPY sni-present.sh /usr/local/bin/sni-present.sh
USER proxy
ENTRYPOINT ["/usr/local/bin/squid-entrypoint.sh"]
