(service_access_log) {
	# Only fixed public paths become labels; arbitrary paths and query strings
	# must never reach the access log.
	map {path} {access_route} {
		default other
		/ home
		/showcase showcase
		/agents agents
		/projects projects
		/docs/connect connect
		/api/v1/agents/register agent_registration
		/api/v1/auth/register user_registration
	}
	map {method} {access_method} {
		default OTHER
		GET GET
		HEAD HEAD
		POST POST
		PUT PUT
		PATCH PATCH
		DELETE DELETE
		OPTIONS OPTIONS
	}
	log_append <service {args[0]}
	log_append <method {access_method}
	log_append <route {access_route}
	log {
		output file /var/log/caddy/services.jsonl {
			mode 0600
			roll_size 25MiB
			roll_keep 4
			roll_keep_for 168h
		}
		format filter {
			wrap json {
				message_key ""
				level_key ""
				name_key ""
				caller_key ""
				stacktrace_key ""
			}
			fields {
				uuid delete
				request delete
				resp_headers delete
				user_id delete
				bytes_read delete
				err_id delete
				err_trace delete
				error delete
			}
		}
	}
}
# End service access logging

# Begin explicit HTTP redirects
http://agentspore.com, http://agentspore.ru, http://www.agentspore.com, http://www.agentspore.ru, http://api.agentspore.com, http://api.agentspore.ru, http://podmemory.agentspore.com, http://podmemory.agentspore.ru, http://otkrytka.agentspore.com, http://otkrytka.agentspore.ru, http://pereklichka.agentspore.com, http://pereklichka.agentspore.ru, http://*.agentspore.com, http://*.agentspore.ru {
	import service_access_log http_redirect
	redir https://{host}{uri} 308
}
# End explicit HTTP redirects

# AgentSpore is served from two mirror domains (same site, same database).
# Everything shared lives in snippets; each domain only imports them. Keep the
# domain list in step with DOMAINS in docker-compose.prod.yml.

www.agentspore.com {
	import service_access_log www.agentspore.com
	redir https://agentspore.com{uri} permanent
}

www.agentspore.ru {
	import service_access_log www.agentspore.ru
	redir https://agentspore.ru{uri} permanent
}

(agentspore_site) {
	# Per-endpoint auth rate limits (requires agentspore-caddy:ratelimit image)
	# These supplement the backend-side Redis limits and stop volumetric abuse at L7
	# before requests hit Python/Postgres.

	# /auth/register — 5 per IP per 10 min (backend also enforces 3/hr, stricter)
	@auth_register {
		method POST
		path /api/v1/auth/register
	}
	rate_limit @auth_register {
		zone register_per_ip {
			key    {remote_host}
			events 5
			window 10m
		}
	}

	# /auth/login — 20 per IP per 5 min (brute force absorbed by backend at 5 failures/15min)
	@auth_login {
		method POST
		path /api/v1/auth/login
	}
	rate_limit @auth_login {
		zone login_per_ip {
			key    {remote_host}
			events 20
			window 5m
		}
	}

	# /auth/forgot-password — 5 per IP per 10 min
	@auth_forgot {
		method POST
		path /api/v1/auth/forgot-password
	}
	rate_limit @auth_forgot {
		zone forgot_per_ip {
			key    {remote_host}
			events 5
			window 10m
		}
	}

	# /auth/resend-verification — 3 per IP per 5 min
	@auth_resend {
		method POST
		path /api/v1/auth/resend-verification
	}
	rate_limit @auth_resend {
		zone resend_per_ip {
			key    {remote_host}
			events 3
			window 5m
		}
	}

	# General API: 60 POST/min per IP (existing policy)
	@api_post {
		method POST
		path /api/*
	}
	rate_limit @api_post {
		zone api_post_per_ip {
			key    {remote_host}
			events 60
			window 1m
		}
	}

	# /metrics — restricted to observability server only
	@metrics_allowed {
		path /metrics
		remote_ip 178.154.244.194
	}
	handle @metrics_allowed {
		reverse_proxy backend:8000
	}
	@metrics_blocked {
		path /metrics
		not remote_ip 178.154.244.194
	}
	handle @metrics_blocked {
		respond 403
	}

	# Backend: API, docs, health, markdown files
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /docs {
		reverse_proxy backend:8000
	}
	# Swagger UI assets live in the backend image; without this the frontend 404s them and /docs is blank
	handle /static/swagger-ui* {
		reverse_proxy backend:8000
	}
	handle /redoc {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /*.md {
		reverse_proxy backend:8000
	}

	# Frontend: everything else
	handle {
		reverse_proxy frontend:3000
	}

	# Access log — rotated file in the caddy_logs volume

	# Security headers (applied to all responses from this vhost)
	header {
		# Content-Security-Policy — allows GA/GTM in addition to self
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com; connect-src 'self' wss://agentspore.com wss://agentspore.ru https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'"
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"
		# XSS protection (legacy browsers)
		X-XSS-Protection "1; mode=block"
		# Prevent MIME sniffing
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove server header
		-Server
	}
}

# Agent services ({handle}.<domain>): the backend gateway resolves the handle from
# the Host header against the service registry (A4) and answers 404 for unknown
# ones. Wildcard certificates need the DNS-01 challenge; the Cloudflare token
# (Zone:DNS:Edit on both zones) comes from the environment, never from this file.
(agentspore_services) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy backend:8000
}

# Nothing uses api.<domain>; the gateway treats it as a platform host, so a
# wildcard route would bypass the /metrics allowlist and the auth rate limits.
api.agentspore.com {
	import service_access_log api.agentspore.com
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	redir https://agentspore.com{uri} 308
}

api.agentspore.ru {
	import service_access_log api.agentspore.ru
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	redir https://agentspore.ru{uri} 308
}

agentspore.com {
	import service_access_log agentspore.com
	import agentspore_site
}

agentspore.ru {
	import service_access_log agentspore.ru
	import agentspore_site
}

*.agentspore.com {
	import service_access_log *.agentspore.com
	import agentspore_services
}

*.agentspore.ru {
	import service_access_log *.agentspore.ru
	import agentspore_services
}

import /etc/caddy/restored-services/*.caddy
